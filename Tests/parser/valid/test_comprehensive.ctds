int globalVar;
float g1, g2;
boolean flag;

void emptyMethod() {
}

int math(int a, float b) {
    int local_var;
    boolean b1, b2;
    local_var = 10;
    
    // Complex expressions
    local_var = -local_var + 5 * (2 - 1) / 3 % 2;
    b1 = !true || false && (local_var < 5);
    b2 = local_var == 10;
    
    // Control structures
    if (b1) {
        int innerVar;
        innerVar = local_var;
        while (innerVar > 0) {
            innerVar = innerVar - 1;
        }
    } else {
        ; // Empty statement
        emptyMethod(); // Method call as statement
    }
    
    // Return with expression
    return local_var;
}

void main() {
    // Return without expression
    return;
}
