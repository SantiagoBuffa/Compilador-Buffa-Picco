func begin duplicar
    recv_param n_1
    t0 = n_1 + n_1
    return t0
func end duplicar

func begin sumar
    recv_param a_2
    recv_param b_3
    t1 = a_2 + b_3
    return t1
func end sumar

func begin main
    t2 = 3
    param t2
    t3 = call duplicar, 1
    t4 = 4
    t5 = 5
    param t4
    param t5
    t6 = call sumar, 2
    param t3
    param t6
    t7 = call sumar, 2
    res_4 = t7
func end main

