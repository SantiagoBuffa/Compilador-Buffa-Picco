func begin computeFour
    recv_param a_1
    recv_param b_2
    recv_param c_3
    recv_param d_4
    t0 = a_1 + b_2
    t1 = c_3 - d_4
    t2 = t0 * t1
    t3 = 2
    t4 = t2 / t3
    return t4
func end computeFour

func begin addTwo
    recv_param x_5
    recv_param y_6
    t5 = x_5 + y_6
    return t5
func end addTwo

func begin main
    t6 = 10
    t7 = 20
    t8 = 30
    t9 = 40
    param t6
    param t7
    param t8
    param t9
    call computeFour, 4
    t10 = 1
    t11 = 2
    param t10
    param t11
    t12 = call addTwo, 2
    t13 = 3
    t14 = 4
    param t13
    param t14
    t15 = call addTwo, 2
    t16 = 10
    t17 = 5
    param t12
    param t15
    param t16
    param t17
    t18 = call computeFour, 4
    result_7 = t18
    return
func end main

