func end operar

func begin comparar
    recv_param x_4
    recv_param y_5
    t5 = x_4 < y_5
    return t5
func end comparar

func begin esIgual
    recv_param x_6
    recv_param y_7
    t6 = x_6 == y_7
    return t6
func end esIgual

func begin main
    t7 = 10.5
    global_f = t7
    t8 = 2.5
