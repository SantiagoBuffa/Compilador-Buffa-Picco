global global_f
func begin operar
    recv_param a_1
    recv_param b_2
    t0 = a_1 + b_2
    t1 = a_1 - b_2
    t2 = t0 * t1
    t3 = 2.0
    t4 = t2 / t3
    res_3 = t4
