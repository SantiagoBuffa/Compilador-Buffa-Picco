func begin testDeadAfterReturn
    recv_param x_1
    t0 = 1
    t1 = x_1 + t0
    a_2 = t1
    return a_2
func end testDeadAfterReturn

func begin testDeadAfterIfElseReturn
    recv_param cond_3
    if_false cond_3 goto L0
    t2 = 1
    return t2
    goto L1
L0:
    t3 = 2
    return t3
L1:
func end testDeadAfterIfElseReturn

func begin testDeadIfTrue
    t4 = 0
    res_4 = t4
    t5 = 42
    res_4 = t5
    t6 = 42
    return t6
func end testDeadIfTrue

func begin testDeadIfFalseNoElse
    t7 = 10
    res_5 = t7
    t8 = 10
    return t8
func end testDeadIfFalseNoElse

func begin testDeadWhile
    t9 = 5
    count_6 = t9
    t10 = 5
    return t10
func end testDeadWhile

func begin main
    t11 = 10
    param t11
    t12 = call testDeadAfterReturn, 1
    r1_7 = t12
    t13 = 1
    param t13
    t14 = call testDeadAfterIfElseReturn, 1
    r2_8 = t14
    t15 = call testDeadIfTrue, 0
    r3_9 = t15
    t16 = call testDeadIfFalseNoElse, 0
    r4_10 = t16
    t17 = call testDeadWhile, 0
    r5_11 = t17
    return
func end main

