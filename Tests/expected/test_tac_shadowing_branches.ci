global global_val
func begin testParallelBranches
    recv_param flag_1
    if_false flag_1 goto L0
    t0 = 10
    a_2 = t0
    global_val = a_2
    goto L1
L0:
    t1 = 20
    a_3 = t1
    global_val = a_3
L1:
func end testParallelBranches

func begin testMultiLevelNesting
    t2 = 1
    x_4 = t2
    t3 = 2
    x_5 = t3
    t4 = 3
    x_6 = t4
    global_val = x_6
    global_val = x_5
    global_val = x_4
func end testMultiLevelNesting

func begin main
    t5 = 0
    global_val = t5
    t6 = 1
    param t6
    call testParallelBranches, 1
    t7 = 0
    param t7
    call testParallelBranches, 1
    call testMultiLevelNesting, 0
    return
func end main

