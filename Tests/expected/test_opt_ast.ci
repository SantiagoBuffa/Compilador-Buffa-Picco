global global_counter
func begin incrementGlobal
    t0 = 1
    t1 = global_counter + t0
    global_counter = t1
func end incrementGlobal

func begin testPropagation
    t2 = 10
    a_1 = t2
    t3 = 15
    b_2 = t3
    t4 = 30
    c_3 = t4
    t5 = 23
    d_4 = t5
    t6 = 23
    return t6
func end testPropagation

func begin testBranches
    recv_param cond_5
    t7 = 100
    x_6 = t7
    if_false cond_5 goto L0
    t8 = 50
    y_7 = t8
    t9 = 200
    x_6 = t9
    goto L1
L0:
    t10 = 50
    y_7 = t10
    t11 = 300
    x_6 = t11
L1:
    t12 = 50
    t13 = t12 + x_6
    return t13
func end testBranches

func begin testLoopSafety
    recv_param limit_8
    t14 = 0
    i_9 = t14
    t15 = 0
    sum_10 = t15
L2:
    t16 = i_9 < limit_8
    if_false t16 goto L3
    t17 = sum_10 + i_9
    sum_10 = t17
    t18 = 1
    t19 = i_9 + t18
    i_9 = t19
    goto L2
L3:
    t20 = sum_10 + i_9
    return t20
func end testLoopSafety

func begin main
    t21 = 0
    global_counter = t21
    t22 = call testPropagation, 0
    r1_11 = t22
    t23 = 1
    param t23
    t24 = call testBranches, 1
    r2_12 = t24
    t25 = 5
    param t25
    t26 = call testLoopSafety, 1
    r3_13 = t26
    call incrementGlobal, 0
    return
func end main

