global side_effects_count
func begin triggerSideEffect
    t0 = 1
    t1 = side_effects_count + t0
    side_effects_count = t1
    t2 = 1
    return t2
func end triggerSideEffect

func begin main
    t3 = 0
    side_effects_count = t3
    t5 = 0
    t4 = t5
    if_false t4 goto L0
    t6 = call triggerSideEffect, 0
    t4 = t6
L0:
    res_1 = t4
    t8 = 1
    t7 = t8
    if t7 goto L1
    t9 = call triggerSideEffect, 0
    t7 = t9
L1:
    res_1 = t7
    t12 = 0
    t11 = t12
    if_false t11 goto L3
    t13 = call triggerSideEffect, 0
    t11 = t13
L3:
    t10 = t11
    if t10 goto L2
    t15 = 0
    t14 = t15
    if_false t14 goto L4
    t16 = call triggerSideEffect, 0
    t14 = t16
L4:
    t10 = t14
L2:
    res_1 = t10
    t18 = 1
    t19 = ! t18
    t17 = t19
    if_false t17 goto L5
    t20 = call triggerSideEffect, 0
    t17 = t20
L5:
    res_1 = t17
